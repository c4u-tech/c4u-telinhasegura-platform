require_relative "lib/store_release"
require "plist"
require "tmpdir"

# Store runs report nothing to fastlane's usage statistics.
opt_out_usage

# Lanes run with app/fastlane as the working directory; Flutter commands
# run from app/.
APP_DIR = File.expand_path("..", __dir__)
APP_ID = "tech.coding4u.telinhasegura"

# Workload identity: the auth step writes a short-lived credentials file
# and exports its path; no long-lived key is stored anywhere.
def play_credentials
  ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS")
end

def play_codes(track)
  google_play_track_version_codes(package_name: APP_ID, track: track, json_key: play_credentials)
end

# Every track that can hold a build; Play refuses a version code it has
# seen on any of them, and an empty track reads as [].
PLAY_TRACKS = %w[internal alpha beta production].freeze

# The production releases as Play reports them, read in an edit that is
# thrown away afterwards.
def play_production_releases
  require "supply"
  require "supply/options"
  require "supply/client"
  Supply.config = FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    { package_name: APP_ID, json_key: play_credentials },
  )
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: APP_ID)
  client.track_releases("production")
ensure
  client.abort_current_edit if client && client.current_edit
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
  )
end

def testflight_latest(api_key)
  latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
end

def build_number_option(options)
  Integer(options.fetch(:build_number))
end

def flutter_build(*args)
  Dir.chdir(APP_DIR) do
    sh("dart", "run", "tool/check_app_env.dart", "config/prd.json")
    sh("flutter", "build", *args, "--release", "--dart-define-from-file=config/prd.json")
  end
end

def no_listing_changes
  { skip_upload_metadata: true, skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true }
end

desc "Print the next build number (one past the highest on either store)"
lane :build_number do
  n = StoreRelease.next_build_number(PLAY_TRACKS.flat_map { |t| play_codes(t) }, testflight_latest(asc_api_key))
  File.write(ENV["GITHUB_OUTPUT"], "number=#{n}\n", mode: "a") if ENV["GITHUB_OUTPUT"]
  UI.message("Next build number: #{n}")
  n
end

desc "Build the production app bundle and upload it to Play internal testing"
lane :android_internal do |options|
  n = build_number_option(options)
  if StoreRelease.already_uploaded?(play_codes("internal"), n)
    UI.important("Build #{n} is already on Play internal testing; skipping the upload.")
    next
  end
  flutter_build("appbundle", "--build-number=#{n}")
  upload_to_play_store(
    package_name: APP_ID,
    json_key: play_credentials,
    track: "internal",
    release_status: StoreRelease.release_status(ENV["PLAY_RELEASE_STATUS"]),
    aab: File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab"),
    **no_listing_changes,
  )
end

desc "Build the production IPA and upload it to TestFlight"
lane :ios_testflight do |options|
  n = build_number_option(options)
  api_key = asc_api_key
  if testflight_latest(api_key) >= n
    UI.important("Build #{n} is already on TestFlight; skipping the upload.")
    next
  end
  setup_ci if ENV["CI"]
  match(api_key: api_key, readonly: true)
  profile = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")
  team = ENV.fetch("sigh_#{APP_ID}_appstore_team-id")
  update_code_signing_settings(
    path: File.join(APP_DIR, "ios/Runner.xcodeproj"),
    use_automatic_signing: false,
    targets: ["Runner"],
    build_configurations: ["Release"],
    team_id: team,
    code_sign_identity: "Apple Distribution",
    profile_name: profile,
  )
  export = File.join(Dir.mktmpdir, "ExportOptions.plist")
  File.write(export, {
    "method" => "app-store-connect",
    "teamID" => team,
    "signingStyle" => "manual",
    "provisioningProfiles" => { APP_ID => profile },
  }.to_plist)
  flutter_build("ipa", "--build-number=#{n}", "--export-options-plist=#{export}")
  ipa = Dir[File.join(APP_DIR, "build/ios/ipa/*.ipa")].first
  UI.user_error!("flutter build ipa produced no .ipa in build/ios/ipa") unless ipa
  upload_to_testflight(
    api_key: api_key,
    ipa: ipa,
    skip_waiting_for_build_processing: true,
    distribute_external: false,
  )
end

desc "Promote the build on Play internal testing to production, staged"
lane :android_promote do |options|
  upload_to_play_store(
    package_name: APP_ID,
    json_key: play_credentials,
    track: "internal",
    track_promote_to: "production",
    version_code: build_number_option(options),
    **StoreRelease.promotion(play_production_releases),
    skip_upload_aab: true,
    skip_upload_apk: true,
    **no_listing_changes,
  )
end

desc "Submit the TestFlight build for App Store review, phased and held"
lane :ios_submit do |options|
  require "spaceship"
  api_key = asc_api_key
  version = StoreRelease.version_name(File.read(File.join(APP_DIR, "pubspec.yaml")))
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App Store Connect has no app #{APP_ID}") unless app
  StoreRelease.hold_and_phase(app, version, platform: Spaceship::ConnectAPI::Platform::IOS)
  # Metadata stays as it is in App Store Connect; this step only picks the
  # build and submits it.
  upload_to_app_store(
    api_key: api_key,
    app_identifier: APP_ID,
    app_version: version,
    build_number: build_number_option(options).to_s,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: true,
    submit_for_review: true,
    force: true,
    precheck_include_in_app_purchases: false,
    submission_information: { add_id_info_uses_idfa: false },
  )
end

desc "Send the store texts, and the images with images:true (no binary, no review submission)"
lane :metadata do |options|
  # Images are heavy and replace what the stores show, so they go only when
  # asked: fastlane metadata images:true
  images = options[:images].to_s == "true"
  # supply looks up a release on a track before it sends listing texts, even
  # with every upload skipped. Anchor on production once it has a release,
  # otherwise on internal (the first texts go out before the first rollout).
  begin
    track, code = StoreRelease.listing_anchor(play_codes("production"), play_codes("internal"))
  rescue ArgumentError => e
    UI.user_error!(e.message)
  end
  upload_to_play_store(
    package_name: APP_ID,
    json_key: play_credentials,
    track: track,
    version_code: code,
    metadata_path: File.join(APP_DIR, "fastlane/metadata/android"),
    skip_upload_aab: true,
    skip_upload_apk: true,
    skip_upload_images: !images,
    skip_upload_screenshots: !images,
    skip_upload_changelogs: true
  )
  # The texts attach to the pubspec version, which is created if it does not
  # exist yet.
  upload_to_app_store(
    api_key: asc_api_key,
    app_identifier: APP_ID,
    app_version: StoreRelease.version_name(File.read(File.join(APP_DIR, "pubspec.yaml"))),
    metadata_path: File.join(APP_DIR, "fastlane/metadata/ios"),
    skip_binary_upload: true,
    skip_screenshots: !images,
    screenshots_path: File.join(APP_DIR, "fastlane/screenshots/ios"),
    overwrite_screenshots: true,
    submit_for_review: false,
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false
  )
end

desc "Move the Play production rollout: step:50, step:100 or step:halt"
lane :android_rollout do |options|
  live = StoreRelease.in_progress_release(play_production_releases)
  UI.user_error!("Play production has no staged rollout in progress to move") unless live
  upload_to_play_store(
    package_name: APP_ID,
    json_key: play_credentials,
    track: "production",
    version_code: live[:version_code],
    skip_upload_aab: true,
    skip_upload_apk: true,
    **StoreRelease.rollout_change(options.fetch(:step).to_s, live[:fraction]),
    **no_listing_changes,
  )
end
