{
  "brand": {
    "color": {
      "sun": {
        "$type": "color",
        "$value": "#FFC42E",
        "$extensions": {
          "oklch": "oklch(0.851 0.164 84.8)"
        },
        "$description": "Amarelo-sol: o corpo do mascote. Preenchimento, nunca texto."
      },
      "dark": {
        "$type": "color",
        "$value": "#0F2A30",
        "$extensions": {
          "oklch": "oklch(0.267 0.034 214.3)"
        },
        "$description": "Texto, coroa e máscara; fundo escuro da marca."
      },
      "ink": {
        "$type": "color",
        "$value": "#1E5B66",
        "$extensions": {
          "oklch": "oklch(0.437 0.063 211.8)"
        },
        "$description": "Verde-petróleo: o fundo principal."
      },
      "cream": {
        "$type": "color",
        "$value": "#FBF6EC",
        "$extensions": {
          "oklch": "oklch(0.974 0.014 84.6)"
        },
        "$description": "Fundo claro da marca."
      },
      "beak": {
        "$type": "color",
        "$value": "#FF5A36",
        "$extensions": {
          "oklch": "oklch(0.684 0.207 33.9)"
        },
        "$description": "Coral: o bico e o pingo do i. Só na marca."
      },
      "sky": {
        "$type": "color",
        "$value": "#A9DDE8",
        "$extensions": {
          "oklch": "oklch(0.865 0.056 212.1)"
        },
        "$description": "Azul-céu: fundo de apoio."
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque",
          "sans-serif"
        ],
        "$description": "OFL. Display e wordmark; optical size 96 no wordmark, 12–14 em texto pequeno."
      },
      "wordmark-weight": {
        "$type": "fontWeight",
        "$value": 800
      }
    },
    "mark": {
      "clear-space": {
        "$type": "number",
        "$value": 0.2,
        "$description": "Fração da caixa da figura (o raio de canto do corpo) livre em volta de marca e lockup."
      },
      "min-size": {
        "mark": {
          "$type": "dimension",
          "$value": {
            "value": 48,
            "unit": "px"
          },
          "$description": "Marca primária."
        },
        "simplified": {
          "$type": "dimension",
          "$value": {
            "value": 24,
            "unit": "px"
          }
        },
        "mini": {
          "$type": "dimension",
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "lockup-height": {
          "$type": "dimension",
          "$value": {
            "value": 24,
            "unit": "px"
          }
        },
        "lockup-endorsed-height": {
          "$type": "dimension",
          "$value": {
            "value": 56,
            "unit": "px"
          }
        }
      }
    }
  },
