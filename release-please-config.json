{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "3d7d03a6f8afcd3c7c050e150c8491d1db364f83",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(release): release${component} ${version}",
  "packages": {
    "app": {
      "release-type": "dart",
      "component": "app",
      "exclude-paths": [
        "app/fastlane",
        "app/test",
        "app/store_screens",
        "app/tool",
        "app/deploy",
        "app/Dockerfile",
        "app/.dockerignore",
        "app/Gemfile",
        "app/Gemfile.lock",
        "app/.ruby-version",
        "app/analysis_options.yaml",
        "app/dart_test.yaml",
        "app/README.md"
      ]
    },
    "backend": {
      "release-type": "go",
      "component": "backend"
    }
  }
}
